<div class="ls-light-editor-main">
{{#if renamable}}
{{!-- Named sourceName, not name, so it never mixes with patterns.<i>.name. --}}
<div class="form-group ls-source-name">
  <label>{{localize "LIGHTSOURCES.LightEditor.Fields.SourceName"}}</label>
  <div class="form-fields">
    <input type="text" name="sourceName" value="{{source.name}}" maxlength="64" required>
  </div>
  <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.SourceNameHint"}}</p>
</div>
{{/if}}
<nav class="sheet-tabs tabs" data-group="primary">
  {{#each tabs}}
  <a class="{{this.cssClass}}" data-action="tab" data-group="{{this.group}}" data-tab="{{this.id}}">
    <i class="{{this.icon}}" inert></i>
    <span>{{localize this.label}}</span>
  </a>
  {{/each}}
</nav>

<section class="tab {{tabs.patterns.cssClass}}" data-group="primary" data-tab="patterns">
  <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.PatternsHint"}}</p>
  <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.PreviewHint"}}</p>

  <button type="button" class="ls-pattern-add" data-action="addPattern">
    <i class="fa-solid fa-plus" inert></i>
    <span>{{localize "LIGHTSOURCES.Patterns.Add"}}</span>
  </button>

  <div class="ls-pattern-list">
    {{#each patterns}}
    <fieldset class="ls-pattern-card" data-pattern-index="{{this.index}}">
      <div class="ls-pattern-head">
        <span class="ls-pattern-number" inert>{{this.number}}</span>
        <input type="hidden" name="patterns.{{this.index}}.id" value="{{this.id}}">
        <input type="text" class="ls-pattern-name" name="patterns.{{this.index}}.name"
               value="{{this.name}}" placeholder="{{localize 'LIGHTSOURCES.Patterns.NamePlaceholder'}}"
               aria-label="{{localize 'LIGHTSOURCES.Patterns.NamePlaceholder'}}">
        {{#if this.canRestore}}
        <button type="button" class="ls-pattern-restore" data-action="restorePattern" data-pattern-index="{{this.index}}"
                data-tooltip="{{localize 'LIGHTSOURCES.Patterns.Restore'}}" aria-label="{{localize 'LIGHTSOURCES.Patterns.Restore'}}">
          <i class="fa-solid fa-rotate-left" inert></i>
        </button>
        {{/if}}
        {{#if ../canRemove}}
        <button type="button" class="ls-pattern-remove" data-action="removePattern" data-pattern-index="{{this.index}}"
                data-tooltip="{{localize 'LIGHTSOURCES.Patterns.Remove'}}" aria-label="{{localize 'LIGHTSOURCES.Patterns.Remove'}}">
          <i class="fa-solid fa-trash" inert></i>
        </button>
        {{/if}}
      </div>

      <div class="ls-pattern-body">
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Negative"}}</label>
          <div class="form-fields">
            <input type="checkbox" name="patterns.{{this.index}}.light.negative" {{checked this.light.negative}}>
          </div>
          <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.NegativeHint"}}</p>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Dim"}}</label>
          <div class="form-fields ls-value-field">
            <input type="number" name="patterns.{{this.index}}.light.dim" value="{{this.light.dim}}" min="0" step="0.5">
            <select class="ls-value-preset" data-target="patterns.{{this.index}}.light.dim" aria-label="{{localize 'LIGHTSOURCES.LightEditor.Fields.RangePreset'}}">
              {{#each this.dimPresets}}
              <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Bright"}}</label>
          <div class="form-fields ls-value-field">
            <input type="number" name="patterns.{{this.index}}.light.bright" value="{{this.light.bright}}" min="0" step="0.5">
            <select class="ls-value-preset" data-target="patterns.{{this.index}}.light.bright" aria-label="{{localize 'LIGHTSOURCES.LightEditor.Fields.RangePreset'}}">
              {{#each this.brightPresets}}
              <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Angle"}}</label>
          <div class="form-fields">
            <range-picker name="patterns.{{this.index}}.light.angle" value="{{this.light.angle}}" min="5" max="360" step="5"></range-picker>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Color"}}</label>
          <div class="form-fields">
            <color-picker name="patterns.{{this.index}}.light.color" value="{{this.light.color}}"></color-picker>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Alpha"}}</label>
          <div class="form-fields">
            <range-picker name="patterns.{{this.index}}.light.alpha" value="{{this.light.alpha}}" min="0" max="1" step="0.05"></range-picker>
          </div>
        </div>

        <hr>

        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.AnimationType"}}</label>
          <div class="form-fields">
            <select name="patterns.{{this.index}}.light.animation.type">
              <option value="">{{localize "LIGHTSOURCES.LightEditor.Fields.AnimationNone"}}</option>
              {{#each this.animationTypes}}
              <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Speed"}}</label>
          <div class="form-fields">
            <range-picker name="patterns.{{this.index}}.light.animation.speed" value="{{this.light.animation.speed}}" min="1" max="10" step="1"></range-picker>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Intensity"}}</label>
          <div class="form-fields">
            <range-picker name="patterns.{{this.index}}.light.animation.intensity" value="{{this.light.animation.intensity}}" min="1" max="10" step="1"></range-picker>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Reverse"}}</label>
          <div class="form-fields">
            <input type="checkbox" name="patterns.{{this.index}}.light.animation.reverse" {{checked this.light.animation.reverse}}>
          </div>
        </div>

        <details class="ls-pattern-section" data-section="ending" data-pattern-id="{{this.id}}"{{#if this.endingOpen}} open{{/if}}>
          <summary>{{localize "LIGHTSOURCES.LightEditor.Fields.Ending"}}</summary>
          <div class="form-group">
            <label>{{localize "LIGHTSOURCES.LightEditor.Fields.EndingEnabled"}}</label>
            <div class="form-fields">
              <input type="checkbox" name="patterns.{{this.index}}.light.endingEnabled" {{checked this.endingEnabled}}>
            </div>
            <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.EndingEnabledHint"}}</p>
          </div>
          <fieldset class="ls-section-fields"{{#unless this.endingEnabled}} disabled{{/unless}}>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Dim"}}</label>
              <div class="form-fields ls-value-field">
                <input type="number" name="patterns.{{this.index}}.light.ending.dim" value="{{this.ending.dim}}" min="0" step="0.5">
                <select class="ls-value-preset" data-target="patterns.{{this.index}}.light.ending.dim" aria-label="{{localize 'LIGHTSOURCES.LightEditor.Fields.RangePreset'}}">
                  {{#each this.endingDimPresets}}
                  <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Bright"}}</label>
              <div class="form-fields ls-value-field">
                <input type="number" name="patterns.{{this.index}}.light.ending.bright" value="{{this.ending.bright}}" min="0" step="0.5">
                <select class="ls-value-preset" data-target="patterns.{{this.index}}.light.ending.bright" aria-label="{{localize 'LIGHTSOURCES.LightEditor.Fields.RangePreset'}}">
                  {{#each this.endingBrightPresets}}
                  <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Color"}}</label>
              <div class="form-fields">
                <color-picker name="patterns.{{this.index}}.light.ending.color" value="{{this.ending.color}}"></color-picker>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Alpha"}}</label>
              <div class="form-fields">
                <range-picker name="patterns.{{this.index}}.light.ending.alpha" value="{{this.ending.alpha}}" min="0" max="1" step="0.05"></range-picker>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.AnimationType"}}</label>
              <div class="form-fields">
                <select name="patterns.{{this.index}}.light.ending.animation.type">
                  <option value="">{{localize "LIGHTSOURCES.LightEditor.Fields.AnimationNone"}}</option>
                  {{#each this.endingAnimationTypes}}
                  <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Speed"}}</label>
              <div class="form-fields">
                <range-picker name="patterns.{{this.index}}.light.ending.animation.speed" value="{{this.ending.animation.speed}}" min="1" max="10" step="1"></range-picker>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Intensity"}}</label>
              <div class="form-fields">
                <range-picker name="patterns.{{this.index}}.light.ending.animation.intensity" value="{{this.ending.animation.intensity}}" min="1" max="10" step="1"></range-picker>
              </div>
            </div>
            <div class="form-group">
              <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Reverse"}}</label>
              <div class="form-fields">
                <input type="checkbox" name="patterns.{{this.index}}.light.ending.animation.reverse" {{checked this.ending.animation.reverse}}>
              </div>
            </div>
          </fieldset>
        </details>

        {{#unless this.light.negative}}
        <details class="ls-pattern-section" data-section="advanced" data-pattern-id="{{this.id}}"{{#if this.advancedOpen}} open{{/if}}>
          <summary>{{localize "LIGHTSOURCES.LightEditor.Fields.Advanced"}}</summary>
          <div class="form-group">
            <label>{{localize "LIGHTSOURCES.LightEditor.Fields.AdvancedEnabled"}}</label>
            <div class="form-fields">
              <input type="checkbox" name="patterns.{{this.index}}.light.advancedEnabled" {{checked this.advancedEnabled}}>
            </div>
            <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.AdvancedEnabledHint"}}</p>
          </div>
          <fieldset class="ls-section-fields"{{#unless this.advancedEnabled}} disabled{{/unless}}>
            {{formGroup ../advancedFields.coloration name=(concat "patterns." this.index ".light.advanced.coloration")
                        value=this.advanced.coloration choices=../colorationTechniques valueAttr="id" labelAttr="label" localize=true}}
            {{formGroup ../advancedFields.luminosity name=(concat "patterns." this.index ".light.advanced.luminosity")
                        value=this.advanced.luminosity step=0.05}}
            {{formGroup ../advancedFields.attenuation name=(concat "patterns." this.index ".light.advanced.attenuation")
                        value=this.advanced.attenuation step=0.05}}
            {{formGroup ../advancedFields.saturation name=(concat "patterns." this.index ".light.advanced.saturation")
                        value=this.advanced.saturation step=0.05}}
            {{formGroup ../advancedFields.contrast name=(concat "patterns." this.index ".light.advanced.contrast")
                        value=this.advanced.contrast step=0.05}}
            {{formGroup ../advancedFields.shadows name=(concat "patterns." this.index ".light.advanced.shadows")
                        value=this.advanced.shadows step=0.05}}
          </fieldset>
        </details>
        {{/unless}}
      </div>
    </fieldset>
    {{/each}}
  </div>
</section>

<section class="tab {{tabs.usage.cssClass}}" data-group="primary" data-tab="usage">
  <div class="form-group">
    <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Consume"}}</label>
    <div class="form-fields">
      <select name="consume">
        {{#each consumeModes}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.ConsumeHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Coverable"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="coverable" {{checked source.coverable}}>
    </div>
    <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.CoverableHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Droppable"}}</label>
    <div class="form-fields">
      <input type="checkbox" name="droppable" {{checked source.droppable}}>
    </div>
    <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.DroppableHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "LIGHTSOURCES.LightEditor.Fields.Duration"}}</label>
    <div class="form-fields ls-value-field">
      <input type="number" name="durationMinutes" value="{{source.durationMinutes}}" min="0" step="1">
      <select class="ls-value-preset" data-target="durationMinutes" aria-label="{{localize 'LIGHTSOURCES.LightEditor.Fields.DurationPreset'}}">
        {{#each durationPresets}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.DurationHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "LIGHTSOURCES.LightEditor.Fields.EndingMinutes"}}</label>
    <div class="form-fields ls-value-field">
      <input type="number" name="endingMinutes" value="{{source.endingMinutes}}" min="0" step="1">
      <select class="ls-value-preset" data-target="endingMinutes" aria-label="{{localize 'LIGHTSOURCES.LightEditor.Fields.DurationPreset'}}">
        {{#each endingPresets}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.EndingMinutesHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "LIGHTSOURCES.LightEditor.Fields.DurationMode"}}</label>
    <div class="form-fields">
      <select name="durationMode">
        {{#each durationModes}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </div>
    <p class="hint">{{localize "LIGHTSOURCES.LightEditor.Fields.DurationModeHint"}}</p>
  </div>
</section>

<footer class="form-footer">
  <button type="submit">
    <i class="fa-solid fa-floppy-disk" inert></i>
    <span>{{localize "LIGHTSOURCES.LightEditor.Save"}}</span>
  </button>
</footer>
</div>
